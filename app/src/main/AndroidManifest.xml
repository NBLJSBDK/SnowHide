<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Shizuku API 权限（shell 身份执行冻结/解冻） -->
    <uses-permission android:name="moe.shizuku.manager.permission.API_V23" />

    <!-- Android 11+ 查询全部已装应用（增加应用界面） -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <!-- dock 长按上锁震动反馈 -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- 快捷方式执行结果通知（Android 13+ 运行时申请） -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SnowHide">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.SnowHide">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- App Shortcuts 透明入口（设计文档 §3.12，独立 taskAffinity，执行即退；
             NoDisplay=无窗口闪现） -->
        <activity
            android:name=".feature.shortcut.ShortcutActionActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:taskAffinity="com.nbljsbdk.snowhide.shortcut"
            android:theme="@android:style/Theme.NoDisplay" />

        <!-- 快速启停下拉磁贴（§3.9） -->
        <service
            android:name=".service.QuickToggleTileService"
            android:exported="true"
            android:icon="@drawable/ic_toggle_off"
            android:label="快速启停"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- ShizukuProvider：Shizuku binder 获取入口（官方文档要求手动声明，
             provider 库的 AAR 只带 meta-data 不自动注册此组件） -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:multiprocess="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />
    </application>

</manifest>